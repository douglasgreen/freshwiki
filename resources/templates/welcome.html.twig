{% extends 'base.html.twig' %}

{% block title %}
  Welcome - FreshWiki
{% endblock %}

{% block content %}
  <div class="row">
    <div class="col-md-8">
      <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Welcome to FreshWiki</h4>
        </div>
        <div class="card-body">
          <p class="lead">
            Hello, {{ username }}!
          </p>
          <p>
            FreshWiki is an opinionated, hierarchy-first wiki engine. Browse
            content by navigating through categories, or use the management
            tools to organize your wiki.
          </p>
          <div class="d-grid gap-2 d-md-block">
            <a href="?action=browse" class="btn btn-primary">Browse Content</a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <a href="?action=browse" class="btn btn-outline-primary">
              Browse Content
            </a>
            <a href="?action=node" class="btn btn-outline-primary">
              Node Management
            </a>
            <a href="?action=tag" class="btn btn-outline-secondary">
              Tag Management
            </a>
            <a href="?action=logout" class="btn btn-outline-danger">Logout</a>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
