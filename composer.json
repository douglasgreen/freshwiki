{
  "modified": "2026-03-19",
  "name": "douglasgreen/freshwiki",
  "description": "An opinionated, hierarchy-first wiki engine built on PHP and MySQL",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "douglasgreen/php-linter": "^1.3.2",
    "friendsofphp/php-cs-fixer": "^3.94.2",
    "phpstan/phpstan": "^2.1.42",
    "phpunit/phpunit": "^12.5.14",
    "rector/rector": "^2.3.9"
  },
  "autoload": {
    "psr-4": {
      "DouglasGreen\\FreshWiki\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "php-linter",
      "php-cs-fixer fix --dry-run --verbose",
      "phpstan analyse",
      "rector process --dry-run"
    ],
    "lint:fix": [
      "php-cs-fixer fix",
      "rector process"
    ],
    "qa": [
      "@lint"
    ]
  }
}
